#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    macros {
        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LSHIFT &kp N2>,
                <&macro_release>,
                <&macro_wait_time 75>,
                <&to 4>;

            label = "TO_RU";
            wait-ms = <50>;
        };

        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL &kp LSHIFT &kp N1>,
                <&macro_release>,
                <&macro_wait_time 75>,
                <&to 0>;

            label = "TO_EN";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E  &kp R          &kp T                                                        &kp Y        &kp U          &kp I      &kp O    &kp P     &kp MINUS
&kp GRAVE  &kp A  &kp S  &kp D  &kp F          &kp G                                                        &kp H        &kp J          &kp K      &kp L    &kp SEMI  &kp SQT
&to_ru     &kp Z  &kp X  &kp C  &kp V          &kp B        &kp LBKT              &kp RBKT                  &kp N        &kp M          &kp COMMA  &kp DOT  &kp FSLH  &kp NUBS
                                &mt LCTRL TAB  &lt 1 SPACE  &mt LGUI BACKSPACE    &mt LEFT_SHIFT BACKSPACE  &lt 2 ENTER  &mt LALT FSLH
            >;

            display-name = "Base";
            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        nav {
            bindings = <
&trans  &kp N1     &kp N2     &kp N3      &kp N4     &kp N5                             &kp N6        &kp N7          &kp N8     &kp N9           &kp N0         &trans
&trans  &kp HOME   &kp INS    &kp DELETE  &kp END    &kp LA(LSHFT)                      &kt LEFT      &kp DOWN_ARROW  &kp UP     &kp RIGHT_ARROW  &trans         &trans
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)   &kp LC(V)  &kp PRINTSCREEN  &trans    &trans  &kp CAPSLOCK  &kp LC(LEFT)    &kp PG_DN  &kp PG_UP        &kp LC(RIGHT)  &trans
                                          &trans     &trans           &trans    &trans  &mo 3         &trans
            >;

            display-name = "Nav";
        };

        sym {
            bindings = <
&trans     &kp EXCLAMATION  &kp AT_SIGN  &kp HASH         &kp DOLLAR    &kp PERCENT                    &kp CARET             &kp AMPERSAND   &kp ASTERISK     &kp RBKT               &kp DLLR  &kp MINUS
&kp GRAVE  &kp K_UNDO       &kp K_COPY   &kp K_PASTE      &kp MINUS     &kp PLUS                       &kp LEFT_PARENTHESIS  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp RIGHT_PARENTHESIS  &kp SEMI  &kp SQT
&trans     &kp DOT          &kp COMMA    &kp EXCLAMATION  &kp QUESTION  &kp COLON    &trans    &trans  &kp EXCL              &kp PIPE        &kp COMMA        &kp DOT                &kp FSLH  &kt NUBS
                                                          &trans        &mo 3        &trans    &trans  &trans                &trans
            >;

            display-name = "Symbols";
        };

        adj {
            bindings = <
&bootloader  &trans  &kp F1  &kp F2   &kp F3   &kp F4                     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2      &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&trans       &trans  &kp F5  &kp F6   &kp F7   &kp F8                     &out OUT_BLE  &kp C_VOL_DN  &kp C_MUTE        &kp C_VOL_UP  &trans        &studio_unlock
&trans       &trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans    &trans  &out OUT_USB  &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT    &trans        &trans
                                      &trans   &trans   &trans    &trans  &trans        &trans
            >;

            display-name = "Adjust";
        };

        cyrilic {
            bindings = <
&kp ESC    &kp RU_CYRILLIC_SHORT_I  &kp RU_CYRILLIC_TSE   &kp RU_CYRILLIC_U   &kp RU_CYRILLIC_KA    &kp RU_CYRILLIC_IE                                                  &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE        &kp RU_CYRILLIC_SHA  &kp RU_CYRILLIC_SHCHA  &kp RU_CYRILLIC_ZE   &kp RU_CYRILLIC_IO
&kp GRAVE  &kp RU_CYRILLIC_EF       &kp RU_CYRILLIC_YERU  &kp RU_CYRILLIC_VE  &kp RU_CYRILLIC_A     &kp RU_CYRILLIC_PE                                                  &kp RU_CYRILLIC_ER  &kp RU_CYRILLIC_O          &kp RU_CYRILLIC_EL   &kp RU_CYRILLIC_DE     &kp RU_CYRILLIC_ZHE  &kp RU_CYRILLIC_HA
&to_en     &kp RU_CYRILLIC_YA       &kp RU_CYRILLIC_CHE   &kp RU_CYRILLIC_ES  &kp RU_CYRILLIC_EM    &kp RU_CYRILLIC_I   &kp LEFT_BRACKET      &kp RIGHT_BRACKET         &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE   &kp RU_CYRILLIC_YU     &kp RU_CYRILLIC_E    &kp RU_CYRILLIC_HARD_SIGN
                                                                              &mt LEFT_CONTROL TAB  &lt 1 SPACE         &mt LGUI BACKSPACE    &mt LEFT_SHIFT BACKSPACE  &lt 2 ENTER         &mt LEFT_ALT FSLH
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>;
        };
    };
};
